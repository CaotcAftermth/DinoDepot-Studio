# DinoDepot Feedback service configuration.
#
# In production these are Cloudflare Worker secrets and variables, not a file:
#
#   wrangler secret put GITHUB_APP_ID
#   wrangler secret put GITHUB_APP_PRIVATE_KEY
#   wrangler secret put GITHUB_INSTALLATION_ID
#   wrangler secret put IDENTITY_SALT
#
# This file exists so the names and shapes are written down, and for
# `wrangler dev`, which reads a local `.dev.vars` in the same format.
# Never commit a filled-in copy.

# --- Required ---------------------------------------------------------------

# The GitHub App's numeric id, from Settings -> Developer settings -> GitHub Apps.
GITHUB_APP_ID=123456

# The app's private key, PEM. Both PKCS#1 ("BEGIN RSA PRIVATE KEY", which is
# what GitHub hands you) and PKCS#8 ("BEGIN PRIVATE KEY") are accepted.
# For a single-line environment variable, replace newlines with \n.
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----\n"

# The installation id. Visible in the URL when you open the app's installation:
# https://github.com/settings/installations/<this number>
GITHUB_INSTALLATION_ID=87654321

# The repository issues are filed into. The application's own repository -
# never a user's project repository.
GITHUB_OWNER=CaotcAftermth
GITHUB_REPO=DinoDepot-Studio

# --- Recommended ------------------------------------------------------------

# Any long random string. Installation ids and source addresses are salted with
# this before being hashed for rate limiting, so the stored keys are useless
# outside this deployment. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IDENTITY_SALT=

# --- Optional ---------------------------------------------------------------

# Reports per installation per hour, and per source address per hour.
RATE_LIMIT_PER_HOUR=10
RATE_LIMIT_PER_IP_PER_HOUR=30

# Public base URL of the attachment bucket, if one is bound. Without both a
# bucket binding and this URL, attachments are refused and the reporter is told.
ATTACHMENTS_BASE_URL=

# A key the client must present as the X-Feedback-Key header.
#
# Leave this empty for a public deployment. A key compiled into an application
# anybody can download is not a secret, and setting one would only make the
# endpoint look protected. Use it when the service is private and the key can
# be handed out separately.
FEEDBACK_SHARED_KEY=
