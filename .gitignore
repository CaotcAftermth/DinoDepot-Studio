# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
/exports/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Tauri updater signing keys. The private key is never committed - it lives in
# a GitHub Actions secret and, offline, in whatever the maintainer keeps
# passwords in. A leaked one lets somebody sign an update this app will install.
*.key
*.key.pub
.tauri/
src-tauri/target/

# Locally built development packages. Never published; see docs/local-package-testing.md
dev-packages/

# Generated from the exact official version in index.json before dev/build.
/src-tauri/resources/official-package/*
!/src-tauri/resources/official-package/.gitkeep

# Asset sidecar build output. The Oodle library it caches beside itself is
# Epic's redistributable, not ours to commit.
sidecar-assets/bin/
sidecar-assets/obj/
# The publish folder is a bundle resource, so the path has to exist for the
# Rust build script even on a checkout that has not run `npm run build:assets`.
sidecar-assets/publish/*
!sidecar-assets/publish/.gitkeep

# Feedback service secrets for `wrangler dev`. The GitHub App private key goes
# in here locally and in Cloudflare's secret store in production - never in the
# repository. See services/feedback-api/.env.example for the shape.
services/feedback-api/.dev.vars
.dev.vars
