{
  "name": "dino-depot-studio",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "scan:modpacks": "node scripts/scan-data-only-modpacks.mjs Public_Content/ModPacks",
    "scan:public-assets": "node scripts/scan-public-asset-boundary.mjs",
    "publish:rights-assets": "node scripts/publish-rights-assets.mjs",
    "prepare:rights-revocation": "node scripts/prepare-rights-revocation.mjs",
    "test:rights-tooling": "node --test scripts/rights-assets-tooling.test.mjs",
    "build:official-data": "node scripts/build-official-data-package.mjs",
    "stage:official": "node scripts/stage-bundled-official.mjs",
    "dev": "npm run stage:official && vite",
    "build": "npm run stage:official && tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:assets": "dotnet publish sidecar-assets -c Release -r win-x64 --self-contained true -p:PublishSingleFile=false -o sidecar-assets/publish"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "puppeteer-core": "^25.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@tauri-apps/cli": "^2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "tailwindcss": "^4.3.2",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^3.2.7",
    "wrangler": "^4.127.0"
  }
}
